FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=postgresql://username:password@localhost:5432/delivaroo
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=5
GOOGLE_MAPS_DEFAULT_REGION=KE
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Delivaroo
SMTP_SENDER_EMAIL=
# Public frontend URL for the reset-password route. The API appends ?token=... .
PASSWORD_RESET_URL=http://localhost:5173/reset-password
DEMO_ADMIN_EMAIL=admin@demo.delivaroo.test
DEMO_ADMIN_PASSWORD=DemoAdminPass123!
DEMO_USER_PASSWORD=DemoUserPass123!
ALLOW_REAL_NOTIFICATION_TESTS=false
TEST_NOTIFICATION_EMAIL=
