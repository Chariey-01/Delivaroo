# Flask API origin. Leave blank in development so requests go to /api and are
# forwarded by the Vite proxy (see vite.config.js) to the Flask dev server.
# Set to the deployed API origin in production, e.g. https://delivaroo-api.onrender.com
VITE_API_URL=

# Where the Vite dev proxy forwards /api during local development.
VITE_API_PROXY=http://localhost:5000

# Google Maps JavaScript API key (Maps JavaScript API + Places API + Directions API).
# Restrict the key by HTTP referrer in the Google Cloud console.
# Never commit the real key — copy this file to .env.local and fill it in there.
VITE_GOOGLE_MAPS_API_KEY=

# Default map centre (Nairobi).
VITE_MAP_DEFAULT_LAT=-1.2921
VITE_MAP_DEFAULT_LNG=36.8219
